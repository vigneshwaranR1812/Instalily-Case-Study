# ======================================
# PYTHON (Backend)
# ======================================
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual Environment
venv/
backend/venv/

# Environment variables (VERY IMPORTANT)
.env
*.env

# Python logs
*.log

# ======================================
# DATABASE / STORAGE
# ======================================
*.db
*.sqlite3

backend/data/storage/
backend/data/*.db
backend/data/storage/chroma/

# Optional: keep empty folders
!backend/data/storage/.gitkeep

# ======================================
# NODE / REACT (Frontend)
# ======================================
frontend/node_modules/
frontend/build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ======================================
# OS FILES
# ======================================
.DS_Store
Thumbs.db

# ======================================
# IDE / EDITOR
# ======================================
.vscode/
.idea/

# ======================================
# MISC
# ======================================
*.swp
*.swo